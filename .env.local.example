# Supabase Project Settings > API sayfasından alacaksın
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opsiyonel) Kur güncelleme endpoint'ini korumak için rastgele bir metin belirle.
# Vercel Cron Jobs, isteklerine otomatik olarak "Authorization: Bearer <CRON_SECRET>"
# başlığını ekler. Bu değeri boş bırakırsan endpoint herkese açık ama zararsız kalır
# (sadece herkese açık kur verisini okuyup veritabanına yazar).
CRON_SECRET=
